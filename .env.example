# Ejemplo de .env para desarrollo
# Copia este archivo a `.env` y reemplaza los valores.
# Si tu red bloquea SRV, usa la cadena sin +srv con los hosts directos.

# Opción SRV (preferida cuando funciona):
# MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@cluster0.xxxxx.mongodb.net/<nombreDB>?retryWrites=true&w=majority

# Opción sin SRV (funciona en redes donde la resolución SRV falla):
# MONGODB_URI=mongodb://<usuario>:<contraseña>@ac-zhjldbx-shard-00-00.9p4wooe.mongodb.net:27017,ac-zhjldbx-shard-00-01.9p4wooe.mongodb.net:27017,ac-zhjldbx-shard-00-02.9p4wooe.mongodb.net:27017/<nombreDB>?ssl=true&authSource=admin&retryWrites=true&w=majority

PORT=4000
